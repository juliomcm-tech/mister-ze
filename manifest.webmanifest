{
  "name": "Mister Zé · Dossiê",
  "short_name": "Mister Zé",
  "description": "Duelo Humano vs Mister Zé — análise de jogos, boletins e carteiras virtuais.",
  "lang": "pt-PT",
  "id": "./",
  "start_url": "./?source=app#portal",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0f0a1a",
  "theme_color": "#1b0f36",
  "categories": ["sports", "entertainment"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Falar com o Zé", "short_name": "Zé", "url": "./#ze", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Duelo", "url": "./#duelo", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Carteiras", "url": "./#banca", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*"] }]
    }
  }
}
